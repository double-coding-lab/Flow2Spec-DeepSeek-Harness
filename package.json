{
  "name": "@double-coding/flow2spec-deepseek-harness",
  "version": "1.3.1",
  "description": "Native DeepSeek Harness plugin for Flow2Spec",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs/README.zh-CN.md",
    "assets/readme",
    "cordis.patch.yml",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "pack:check": "npm pack --dry-run",
    "pack:install": "npm run build && node scripts/test-package-install.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@double-coding/flow2spec-core": "^3.8.2",
    "semver": "^7.7.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "oxlint": "^1.76.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/double-coding-lab/Flow2Spec-DeepSeek-Harness.git"
  },
  "homepage": "https://github.com/double-coding-lab/Flow2Spec-DeepSeek-Harness#readme",
  "bugs": {
    "url": "https://github.com/double-coding-lab/Flow2Spec-DeepSeek-Harness/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "flow2spec",
    "cordis",
    "ai-agent"
  ],
  "license": "MIT"
}
